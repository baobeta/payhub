# Template for production.env, the environment of the production image
# (README "Production image", "Configuration"). Placeholders only: copy it,
# fill it in, keep the copy out of git (.gitignore has *.env) and readable by
# its owner only:
#
#   cp production.env.example production.env && chmod 600 production.env
#   bin/generate-secrets --append production.env   # the generated secrets, below
#
# Until a secrets manager exists (D4 in docs/plans/2026-10-21-production-readiness.md),
# this file on the host is where the secrets live; rotation is manual
# (RUNBOOK "Secrets").
#
# One file for web, worker and the migration one-off; what differs per
# container is passed with -e on top of it (README "Production image"):
#
#   web        -e OTEL_SERVICE_NAME=payhub-web    (plus WEB_CONCURRENCY, RAILS_MAX_THREADS)
#   worker     -e OTEL_SERVICE_NAME=payhub-worker -e CHAOS_API_URL=... (demo hosts only)
#              command: bundle exec sidekiq
#   migration  -e DATABASE_URL="$OWNER_DATABASE_URL" (and RUN_MIGRATIONS=true with
#              the command `true`, or the command bin/rails db:prepare)
#
# Never give web or worker the owner URL, RUN_MIGRATIONS or MIGRATION_DATABASE_URL.

# ── Generated secrets: bin/generate-secrets --append production.env ─────────
# Left commented here so --append adds them (it never overwrites a key).
# SECRET_KEY_BASE=                     signs and encrypts cookies and sessions
# AR_ENCRYPTION_PRIMARY_KEY=           Active Record encryption (TOTP secrets);
# AR_ENCRYPTION_DETERMINISTIC_KEY=     changing them makes stored TOTP secrets
# AR_ENCRYPTION_KEY_DERIVATION_SALT=   unreadable: rotate with Rails' previous: keys
# METRICS_TOKEN=                       bearer token for /metrics; the collector needs the same
# APP_DB_PASSWORD=                     payhub_app's password: ALTER ROLE, then DATABASE_URL below
# OWNER_DB_PASSWORD=                   payhub_owner's password: ALTER ROLE, then OWNER_DATABASE_URL

# ── Database ────────────────────────────────────────────────────────────────
# Web and worker: payhub_app, through PgBouncer (transaction mode), always
# with advisory_locks=false and, while Postgres is older than 17,
# prepared_statements=false; TLS verified against PgBouncer's certificate.
# RUNBOOK "Connection pooling", "Database roles".
DATABASE_URL=postgres://payhub_app:<APP_DB_PASSWORD>@<pgbouncer-host>:6432/payhub_production?advisory_locks=false&prepared_statements=false&sslmode=verify-full&sslrootcert=<path to the CA that signed PgBouncer's certificate>
# The migration one-off only, as its DATABASE_URL (-e DATABASE_URL=...), never
# set here as a live line: payhub_owner, straight to Postgres (not PgBouncer).
# OWNER_DATABASE_URL=postgres://payhub_owner:<OWNER_DB_PASSWORD>@<postgres-host>:5432/payhub_production?sslmode=verify-full&sslrootcert=<path to Postgres' CA>
# MIGRATION_DATABASE_URL: leave unset in production (it is for Compose).

# ── Redis (AOF + a failover replica: RUNBOOK "Redis persistence") ───────────
REDIS_URL=redis://<redis-host>:6379/0

# ── The app ─────────────────────────────────────────────────────────────────
APP_HOST=<payhub.example.com>
# Default true: HTTPS redirect, HSTS, secure cookies. false only without TLS.
RAILS_FORCE_SSL=true
RAILS_LOG_LEVEL=info

# ── PSPs (the simulators' defaults are refused at boot) ─────────────────────
NORDPAY_URL=<https://api.nordpay.example>
NORDPAY_API_KEY=<from Nordpay>
NORDPAY_WEBHOOK_SECRET=<from Nordpay>
# While rotating, instead of the single secret: NORDPAY_WEBHOOK_SECRETS=<new>,<old>
KIRIPAY_URL=<https://api.kiripay.example>
KIRIPAY_API_KEY=<from Kiripay>
KIRIPAY_WEBHOOK_SECRET=<from Kiripay>
# While rotating: KIRIPAY_WEBHOOK_SECRETS=<new>,<old>

# ── Mail ────────────────────────────────────────────────────────────────────
SMTP_HOST=<smtp.example.com>
SMTP_PORT=587
SMTP_USERNAME=<smtp user>
SMTP_PASSWORD=<smtp password>
MAIL_FROM=PayHub <no-reply@<your domain>>

# ── Processes ───────────────────────────────────────────────────────────────
# Web only (pass with -e): Puma workers and threads. The worker leaves
# RAILS_MAX_THREADS unset (its pool must cover the Sidekiq concurrency, 5).
# WEB_CONCURRENCY=2
# RAILS_MAX_THREADS=3
# Required with more than one process per service; the image's default:
PROMETHEUS_MULTIPROC_DIR=/rails/tmp/prometheus
PORT=3000
# PIDFILE=
# PUMA_PERSISTENT_TIMEOUT=65
WORKER_METRICS_PORT=9394
WORKER_METRICS_HOST=0.0.0.0

# ── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://<otel-collector-host>:4318
# Per container, with -e: payhub-web on web, payhub-worker on the worker
# (alerts, SLOs and the collector's log filter select on these names).
# OTEL_SERVICE_NAME=payhub-web

# ── Optional ────────────────────────────────────────────────────────────────
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_TEST_PER_MINUTE=75
# DEMO_ENABLED=true          demo-only hosts; never on the real one
# CHAOS_API_URL=             worker on a demo host: web's address

# ── Image only, per container ───────────────────────────────────────────────
# RUN_MIGRATIONS=true        the migration one-off only (command `true`)
# ALLOW_MIGRATE_AND_SERVE=   never in production
