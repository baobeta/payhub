# Runtime artefacts
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids
/tmp/pids/*
!/tmp/pids/.keep
/tmp/storage/*
/storage/*
!/storage/.keep
/public/assets

# Secrets & local config — never commit these
/config/master.key
/config/credentials/*.key
.env
.env.*
!.env.example

# Test / coverage output
/coverage
/spec/examples.txt
/spec/reports

# Tooling caches
/.bundle
/node_modules
/.yarn
.byebug_history
.rspec_status
*.orig
*.rej

# OMC / Claude Code session state
.omc/
.claude/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
/.idea
/.vscode/*
!/.vscode/settings.json

# Sorbet
/sorbet/rbi/hidden-definitions/
.omx/

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vite.dev/guide/env-and-mode.html#env-files
*.local


# Playwright
/test-results/
/playwright-report/
