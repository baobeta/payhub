#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints fresh values for every secret PayHub needs (README "Configuration",
# RUNBOOK "Secrets"). Standard library only; nothing is written unless asked.
#   bin/generate-secrets                       print KEY=value lines to stdout
#   bin/generate-secrets --append production.env
#                                              add the keys that file lacks (mode 600 if
#                                              it is created); never overwrites a key
#
# APP_DB_PASSWORD and OWNER_DB_PASSWORD are the payhub_app and payhub_owner role
# passwords: set them with ALTER ROLE (RUNBOOK "Database roles") and put them in
# the DATABASE_URLs. Hex only, so they go into a URL unescaped.
require "securerandom"

USAGE = "usage: bin/generate-secrets [--append FILE]"

def secrets
  {
    "SECRET_KEY_BASE" => SecureRandom.hex(64), # what bin/rails secret prints
    # The format bin/rails db:encryption:init prints.
    "AR_ENCRYPTION_PRIMARY_KEY" => SecureRandom.alphanumeric(32),
    "AR_ENCRYPTION_DETERMINISTIC_KEY" => SecureRandom.alphanumeric(32),
    "AR_ENCRYPTION_KEY_DERIVATION_SALT" => SecureRandom.alphanumeric(32),
    "METRICS_TOKEN" => SecureRandom.hex(32),
    "APP_DB_PASSWORD" => SecureRandom.hex(24),
    "OWNER_DB_PASSWORD" => SecureRandom.hex(24)
  }
end

case ARGV
in [] then secrets.each { |key, value| puts "#{key}=#{value}" }
in ["-h" | "--help"] then puts USAGE
in ["--append", String => path]
  abort "bin/generate-secrets: #{path} is a directory" if File.directory?(path)

  existing = File.exist?(path) ? File.readlines(path, chomp: true) : []
  # KEY=value is the only form docker run --env-file and Compose's .env read as
  # KEY; "export KEY=" and "KEY =" still count as present here (never
  # overwritten) but are reported.
  lines = existing.filter_map { |line| line.match(/\A\s*(export\s+)?([A-Za-z_][A-Za-z0-9_]*)(\s*)=(.*)\z/) }
  present = lines.map { |m| m[2] }
  added = secrets.reject { |key, _| present.include?(key) }
  skipped = secrets.keys - added.keys

  unless added.empty?
    File.open(path, "a", 0o600) do |file|
      file.puts if existing.any? && !File.read(path).end_with?("\n")
      file.puts "# bin/generate-secrets, #{Time.now.utc.strftime('%Y-%m-%d')}"
      added.each { |key, value| file.puts "#{key}=#{value}" }
    end
  end
  warn "added to #{path}: #{added.keys.join(', ')}" unless added.empty?
  warn "already in #{path}, left as is: #{skipped.join(', ')}" unless skipped.empty?
  lines.select { |m| secrets.key?(m[2]) }.each do |m|
    warn "#{path}: #{m[2]} is empty; fill it in (or delete the line and rerun)" if m[4].strip.empty?
    warn "#{path}: write #{m[2]}=value, not \"#{m[1]}#{m[2]}#{m[3]}=\": docker run --env-file does not read that as #{m[2]}" if m[1] || !m[3].empty?
  end
  mode = File.stat(path).mode & 0o777 if File.exist?(path)
  warn "#{path} is mode #{format('%o', mode)}; run chmod 600 #{path}" if mode && mode & 0o077 != 0
else
  abort USAGE
end
