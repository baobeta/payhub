#!/bin/bash -e

# Entrypoint for both image targets (Dockerfile): web, worker and vite.

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ] && [ -f /usr/lib/*/libjemalloc.so.2 ]; then
  export LD_PRELOAD="$(echo /usr/lib/*/libjemalloc.so.2)"
fi

# Metrics files from a previous start must go, or the restarted process keeps
# their values (stale gauges, PID files reused). RUNBOOK "Metrics across processes".
if [ -n "${PROMETHEUS_MULTIPROC_DIR}" ]; then
  mkdir -p "${PROMETHEUS_MULTIPROC_DIR}"
  find "${PROMETHEUS_MULTIPROC_DIR}" -mindepth 1 -delete
fi

# Opt in, on one container per deploy (e.g. a release task), never on every
# web and worker: concurrent migrations race.
if [ "${RUN_MIGRATIONS}" == "true" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
