{
  "name": "dbml-erd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ungated DBML -> ERD renderer with table groups, header colors and notes",
  "license": "MIT",
  "bin": {
    "dbml-erd": "./bin/dbml-erd.mjs"
  },
  "scripts": {
    "edit": "node bin/dbml-erd.mjs ../../docs/schema.dbml --serve --watch --open",
    "build": "node bin/dbml-erd.mjs ../../docs/schema.dbml"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dbml/core": "^10.3.1",
    "@dbml/parse": "^10.3.1"
  }
}
