        other_array: T.any(::OperatorProposal, T::Enumerable[T.any(::OperatorProposal, T::Enumerable[::OperatorProposal])])
      ).returns(T::Array[::OperatorProposal])
    end
    def replace(other_array); end

    sig { returns(PrivateAssociationRelation) }
    def scope; end

    sig { returns(T::Array[::OperatorProposal]) }
    def target; end

    sig { returns(T::Array[::OperatorProposal]) }
    def to_a; end

    sig { returns(T::Array[::OperatorProposal]) }
    def to_ary; end
  end

  class PrivateRelation < ::ActiveRecord::Relation
    include CommonRelationMethods
    include GeneratedRelationMethods

    Elem = type_member { { fixed: ::OperatorProposal } }

    sig { returns(T::Array[::OperatorProposal]) }
    def to_a; end

    sig { returns(T::Array[::OperatorProposal]) }
    def to_ary; end
  end

