# Local Docker Compose settings. Copy to .env (git-ignored) and change what you
# need: `cp .env.example .env`, then `chmod 600 .env`. Every variable here is
# optional; the value shown is the default docker-compose.yml uses when it is
# unset. These are dev-only values that protect nothing: never reuse them
# outside your machine. Production uses production.env (template:
# production.env.example). README "Configuration", RUNBOOK "Secrets".
#
# bin/generate-secrets prints fresh values; `bin/generate-secrets --append .env`
# adds the ones .env does not have yet (it never overwrites a key).

# ── Ports on your machine ───────────────────────────────────────────────────
# The app's host port (links in emails follow it). Use 3100 if 3000 is taken.
WEB_PORT=3000
GRAFANA_PORT=3300

# ── Postgres ────────────────────────────────────────────────────────────────
# The compose superuser `payhub`'s password, also used by PgBouncer and in the
# web/worker DATABASE_URL, MIGRATION_DATABASE_URL and PGPASSWORD. Read by
# Postgres only when the pgdata volume is first created. To change it later,
# run this as well:
# `docker compose exec db psql -U payhub -c "ALTER ROLE payhub PASSWORD '<new>'"`.
# Letters and digits only (it goes into a URL unescaped).
POSTGRES_PASSWORD=payhub

# ── PSP simulators ──────────────────────────────────────────────────────────
# PayHub (web, worker) and the simulators read the same values, so they always
# match. These defaults are the simulators' own; production refuses them.
NORDPAY_API_KEY=np_test_key
NORDPAY_WEBHOOK_SECRET=np_whsec_test
KIRIPAY_API_KEY=kp_test_key
KIRIPAY_WEBHOOK_SECRET=kp_whsec_test
# Where each simulator POSTs its webhooks. The defaults reach the web service
# inside compose; for Rails run on the host, use
# http://host.docker.internal:3000/v1/webhooks/nordpay (and .../kiripay).
NORDPAY_WEBHOOK_URL=http://web:3000/v1/webhooks/nordpay
PAYHUB_WEBHOOK_URL=http://web:3000/v1/webhooks/kiripay

# ── Metrics and observability ───────────────────────────────────────────────
# Bearer token for /metrics on web and worker; the collector sends it. Empty
# leaves /metrics open outside production. Set it to try the production
# behaviour (README "Metrics").
METRICS_TOKEN=
# ClickHouse user `otel`'s password (ClickHouse, the collector, Grafana's
# datasource).
CLICKHOUSE_PASSWORD=otel
# Where Grafana's contact points POST alerts. The defaults go nowhere
# (README "Alerting").
ALERT_WEBHOOK_URL=http://localhost:9/payhub-oncall
ALERT_TICKET_WEBHOOK_URL=http://localhost:9/payhub-tickets

# ── Demo ────────────────────────────────────────────────────────────────────
# Where the worker's demo chaos run sends API requests.
CHAOS_API_URL=http://web:3000
